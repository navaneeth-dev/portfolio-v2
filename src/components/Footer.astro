---
const today = new Date();
---

<footer
  class="bg-black text-white relative z-20 overflow-hidden print:hidden"
  id="contact"
>
  <div
    class="container mx-auto px-12 py-12 after:content-['Contact'] after:absolute after:top-1/2 after:left-1/2 after:-translate-x-1/2 after:-translate-y-1/2 after:text-[15vw] after:opacity-20 after:font-bold after:-z-10"
  >
    <h2 class="text-center font-bold text-2xl mb-6">Contact</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <a
        class="flex flex-col items-center gap-y-2 hover:text-neutral-400"
        href="mailto:me@rizexor.com"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-12 h-12"
        >
          <path
            stroke-linecap="round"
            d="M16.5 12a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zm0 0c0 1.657 1.007 3 2.25 3S21 13.657 21 12a9 9 0 10-2.636 6.364M16.5 12V8.25"
          ></path>
        </svg>
        <p>me@rizexor.com</p>
      </a>
      <a
        class="flex flex-col items-center gap-y-2 hover:text-neutral-400"
        href="https://x.com/navaneethstwt"
        rel="me"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          class="w-12 h-12 p-1.5"
          ><path
            d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"
          ></path></svg
        >
        <p>navaneethstwt</p>
      </a>
      <a
        class="flex flex-col items-center gap-y-2 hover:text-neutral-400"
        href="https://github.com/navaneeth-dev"
        rel="me"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="48"
          height="48"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-github"
          ><path
            d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
          ></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg
        >
        <p>navaneeth-dev</p>
      </a>
    </div>
  </div>
</footer>
