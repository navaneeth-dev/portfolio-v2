---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import {SITE_TITLE, SITE_DESCRIPTION} from "../config";

const {frontmatter = {}} = Astro.props;
const title = frontmatter.title ? `${frontmatter.title} | Navaneeth` : SITE_TITLE;
const description = frontmatter.description ?? SITE_DESCRIPTION;
---

<!doctype html>
<html lang="en">
<head>
  <BaseHead {title} {description}/>
</head>
<body>
<Header/>

<main class="container px-12 mx-auto py-6">
  <div
    class="prose max-w-none prose-code:bg-gray-200 prose-code:before:content-none prose-code:after:content-none"
  >
    <slot/>
  </div>
</main>

<Footer/>
</body>
</html>
